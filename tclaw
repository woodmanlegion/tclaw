#!/data/data/com.termux/files/usr/bin/bash
# tclaw — Termux OpenClaw Maintenance Tool
# Version: 2026.08.29_01
# One script to install, patch, upgrade, and manage OpenClaw on Android/Termux.
#
# Design intent: shipped to a remote machine in one pass, then the local agent
# is guided to interact with and integrate it. Excessively self-documenting by
# design — every convention, stub, and edge case is explained inline.
#
# Conventions:
#   - All functions prefixed with tcw_ to avoid namespace collisions.
#   - Every destructive or state-changing operation is idempotent.
#   - Secrets live in ~/.openclaw/.env, never in openclaw.json.
#   - Patches use content anchors, not hardcoded hashes, so they survive
#     npm upgrades.
#   - Output is human-readable and agent-parseable.
#   - All tclaw state lives in ~/.tclaw/ (logs, etc.)
#   - User binaries go to the first writable XDG-style dir found on PATH:
#     ~/.local/bin > ~/bin > ~/Scripts. Falls back to ~/.local/bin if none found.

set -euo pipefail

# ── Configuration ─────────────────────────────────────────────────────────────

VERSION="2026.08.30_02"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
HOME="${HOME:-/data/data/com.termux/files/home}"
SVDIR="${SVDIR:-$PREFIX/var/service}"

OPENCLAW_PINNED_VERSION="2026.7.1-2"
OPENCLAW_PKG="$PREFIX/lib/node_modules/openclaw"
OPENCLAW_DIST="$OPENCLAW_PKG/dist"
OPENCLAW_CONFIG="$HOME/.openclaw/openclaw.json"
WORKSPACE_BIN="$HOME/.openclaw/workspace/bin"
OPENCLAW_ENV="$HOME/.openclaw/.env"
OPENCLAW_SERVICE_DIR="$SVDIR/openclaw"
OPENCLAW_RUN_SCRIPT="$OPENCLAW_SERVICE_DIR/run"

TCW_DIR="$HOME/.tclaw"
TCW_LOG_DIR="$TCW_DIR/logs"
TCW_LOG_FILE=""   # set by tcw_init_log

# ── Terminal Styling ──────────────────────────────────────────────────────────

BOLD="\033[1m"
GREEN="\033[32m"
YELLOW="\033[33m"
RED="\033[31m"
CYAN="\033[36m"
RESET="\033[0m"

# ── Logging ───────────────────────────────────────────────────────────────────

tcw_init_log() {
    mkdir -p "$TCW_LOG_DIR"
    TCW_LOG_FILE="$TCW_LOG_DIR/$(date +%Y%m%d-%H%M%S).log"
    echo "tclaw $VERSION — $(date)" >> "$TCW_LOG_FILE"
    echo "cmd: $*" >> "$TCW_LOG_FILE"
}

_tcw_log_file() {
    [[ -n "$TCW_LOG_FILE" ]] && echo "$*" >> "$TCW_LOG_FILE" || true
}

tcw_log()  { echo -e "${CYAN}[tclaw]${RESET} $*";          _tcw_log_file "[log]  $*"; }
tcw_ok()   { echo -e "${GREEN}[tclaw] ✓${RESET} $*";       _tcw_log_file "[ok]   $*"; }
tcw_warn() { echo -e "${YELLOW}[tclaw] ⚠${RESET} $*" >&2;  _tcw_log_file "[warn] $*"; }
tcw_err()  { echo -e "${RED}[tclaw] ✗${RESET} $*" >&2;     _tcw_log_file "[err]  $*"; }

# ── User Bin Detection ────────────────────────────────────────────────────────
# Find the first XDG-style user bin directory that is already on PATH.
# Precedence: ~/.local/bin > ~/bin > ~/Scripts
# Falls back to ~/.local/bin if none are on PATH (and creates it).

tcw_find_user_bin() {
    local candidates=("$HOME/.local/bin" "$HOME/bin" "$HOME/Scripts")
    for dir in "${candidates[@]}"; do
        if echo "$PATH" | tr ':' '\n' | grep -qx "$dir"; then
            echo "$dir"
            return
        fi
    done
    echo "$HOME/.local/bin"
}

USER_BIN="$(tcw_find_user_bin)"

# ── Helpers ───────────────────────────────────────────────────────────────────

tcw_need_cmd() {
    local cmd="$1"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        tcw_err "required command not found: $cmd"
        tcw_err "Install it first, then re-run tclaw."
        exit 1
    fi
}

tcw_ensure_dirs() {
    mkdir -p \
        "$WORKSPACE_BIN" \
        "$USER_BIN" \
        "$HOME/Projects" \
        "$HOME/.openclaw" \
        "$HOME/.pi/agent/skills/local-scripts" \
        "$TCW_LOG_DIR" \
        "$SVDIR"
    tcw_ok "directories ensured (workspace bin: $WORKSPACE_BIN, user bin: $USER_BIN)"
}

tcw_find_dist_file() {
    local pattern="$1"
    local anchor="${2:-}"
    local file=""
    if [[ -n "$anchor" ]]; then
        file=$(grep -rl "$anchor" "$OPENCLAW_DIST" 2>/dev/null | grep "/$(echo "$pattern" | sed 's/\*/.*/g')$" | head -1)
    fi
    if [[ -z "$file" ]]; then
        file=$(find "$OPENCLAW_DIST" -maxdepth 1 -name "$pattern" -type f 2>/dev/null | head -1)
    fi
    if [[ -z "$file" || ! -f "$file" ]]; then
        tcw_err "no file matching $pattern in $OPENCLAW_DIST"
        return 1
    fi
    echo "$file"
}

# ── Patches ───────────────────────────────────────────────────────────────────

tcw_patch_all() {
    tcw_log "applying patches via patch-engine..."
    tcw_need_cmd node
    tcw_need_cmd sv
    if [[ ! -d "$OPENCLAW_DIST" ]]; then
        tcw_err "OpenClaw dist/ not found. Run: tclaw install"
        exit 1
    fi
    node "$SCRIPT_DIR/lib/patch-engine.js" "$OPENCLAW_DIST" "$SCRIPT_DIR/patches" || {
        tcw_err "patch-engine failed"
        return 1
    }
    tcw_ok "all patches applied"
}

# ── Service Management ────────────────────────────────────────────────────────

tcw_ensure_service_dir() {
    mkdir -p "$OPENCLAW_SERVICE_DIR"
}

tcw_write_run_script() {
    tcw_ensure_service_dir
    local user_bin="$USER_BIN"
    local workspace_bin="$WORKSPACE_BIN"
    cat > "$OPENCLAW_RUN_SCRIPT" <<EOF
#!/data/data/com.termux/files/usr/bin/sh
export OPENCLAW_EXEC_SHELL_SNAPSHOT=0
export OPENCLAW_CHILD_OOM_SCORE_ADJ=0
export PATH="${workspace_bin}:${user_bin}:${PREFIX}/bin:${PREFIX}/bin/applets:/system/bin"
if [ -f "${OPENCLAW_ENV}" ]; then
  . "${OPENCLAW_ENV}"
fi
exec 2>&1
exec openclaw gateway run
EOF
    chmod +x "$OPENCLAW_RUN_SCRIPT"
    tcw_ok "run script: $OPENCLAW_RUN_SCRIPT (workspace: $workspace_bin, user: $user_bin)"
}

tcw_service_up()      { sv up openclaw; }
tcw_service_down()    { sv down openclaw; }
tcw_service_restart() { sv restart openclaw; }
tcw_service_status()  { sv status openclaw; }

# ── Secrets / .env ────────────────────────────────────────────────────────────

tcw_ensure_env_file() {
    if [[ ! -f "$OPENCLAW_ENV" ]]; then
        cat > "$OPENCLAW_ENV" <<'EOF'
# OpenClaw secrets — sourced by the runit service script.
# DISCORD_BOT_TOKEN=...
# OPENCLAW_GATEWAY_TOKEN=...
EOF
        chmod 600 "$OPENCLAW_ENV"
        tcw_ok "created $OPENCLAW_ENV (add your secrets)"
    fi
}

tcw_env_show() {
    if [[ ! -f "$OPENCLAW_ENV" ]]; then
        tcw_warn "no .env file at $OPENCLAW_ENV"
        return 1
    fi
    tcw_log "$OPENCLAW_ENV contents (keys only):"
    grep -E "^[A-Z_]+=" "$OPENCLAW_ENV" | cut -d= -f1 | while read -r key; do
        echo "  $key=***"
    done
}

# ── claw-gh-install bootstrap ────────────────────────────────────────────────
# Installs claw-gh-install as an openclaw skill so it can facilitate all
# subsequent plugin/skill installs from GitHub without manual cloning.

CGI_REPO="woodmanlegion/claw-gh-install"
CGI_TMP="$HOME/.openclaw/workspace/claw-gh/tmp/claw-gh-install"
CGI_BIN="$HOME/.openclaw/workspace/skills/claw-gh-install/bin/claw-gh-install"
CGI_LINK="$WORKSPACE_BIN/claw-gh-install"

tcw_bootstrap_claw_gh_install() {
    if [[ -x "$CGI_LINK" ]]; then
        tcw_ok "claw-gh-install already installed — skipping bootstrap"
        return
    fi

    tcw_log "bootstrapping claw-gh-install from github:$CGI_REPO..."
    mkdir -p "$(dirname "$CGI_TMP")"

    if [[ -d "$CGI_TMP" ]]; then
        git -C "$CGI_TMP" pull --ff-only || tcw_warn "claw-gh-install pull failed — using existing clone"
    else
        git clone "https://github.com/$CGI_REPO" "$CGI_TMP" || {
            tcw_err "failed to clone $CGI_REPO — skipping claw-gh-install bootstrap"
            return 1
        }
    fi

    openclaw skills install "$CGI_TMP" || {
        tcw_err "openclaw skills install failed for claw-gh-install"
        return 1
    }

    ln -sf "$CGI_BIN" "$CGI_LINK"
    tcw_ok "claw-gh-install installed → $CGI_LINK"
    tcw_log "you can now install other repos with: claw-gh-install <owner/repo>"
}

# ── Install ───────────────────────────────────────────────────────────────────

tcw_install() {
    tcw_init_log "install" "$@"
    local use_latest=0 use_fork=0
    for arg in "$@"; do
        [[ "$arg" == "--latest" ]] && use_latest=1
        [[ "$arg" == "--fork"   ]] && use_fork=1
    done

    tcw_log "running full install/setup cycle..."
    tcw_ensure_dirs
    tcw_need_cmd node
    tcw_need_cmd npm
    tcw_need_cmd sv

    local apt_pkgs=(python build-essential jq git curl termux-services)
    tcw_log "installing apt packages: ${apt_pkgs[*]}"
    pkg install -y "${apt_pkgs[@]}" || tcw_warn "some apt packages may already be installed"

    if [[ ! -d "$OPENCLAW_PKG" ]] || [[ "$use_fork" -eq 1 ]] || [[ "$use_latest" -eq 1 ]]; then
        if [[ "$use_fork" -eq 1 && "$use_latest" -eq 1 ]]; then
            tcw_log "installing openclaw from fork HEAD (github:woodmanlegion/openclaw)..."
            tcw_warn "Fork patches are pre-applied — skipping post-install patch step."
            npm install -g --ignore-scripts "github:woodmanlegion/openclaw"
        elif [[ "$use_fork" -eq 1 ]]; then
            tcw_log "installing openclaw from fork (termux/stable)..."
            tcw_warn "Fork patches are pre-applied — skipping post-install patch step."
            npm install -g --ignore-scripts "github:woodmanlegion/openclaw#termux/stable"
        elif [[ "$use_latest" -eq 1 ]]; then
            tcw_warn "Installing openclaw@latest — patches may break on upstream changes."
            npm install -g --ignore-scripts openclaw@latest
        else
            tcw_log "installing openclaw@$OPENCLAW_PINNED_VERSION (pinned, stable)..."
            npm install -g --ignore-scripts "openclaw@$OPENCLAW_PINNED_VERSION"
        fi
    else
        tcw_log "OpenClaw already installed; will ensure patched"
    fi

    tcw_patch_all
    tcw_write_run_script
    tcw_ensure_env_file
    tcw_service_up
    sleep 3
    tcw_bootstrap_claw_gh_install
    tcw_status
    tcw_ok "install complete — log: $TCW_LOG_FILE"
    tcw_warn "Next steps:"
    tcw_warn "  1. Add secrets to $OPENCLAW_ENV"
    tcw_warn "  2. Run 'openclaw onboard' for first-time config"
    tcw_warn "  3. Use 'claw-gh-install <owner/repo>' to install plugins and skills"
    tcw_warn "  4. Run 'tclaw restart' after editing config"
}

# ── Update ────────────────────────────────────────────────────────────────────

tcw_update() {
    tcw_init_log "update" "$@"
    local use_latest=0 use_fork=0
    for arg in "$@"; do
        [[ "$arg" == "--latest" ]] && use_latest=1
        [[ "$arg" == "--fork"   ]] && use_fork=1
    done

    tcw_log "running update cycle..."
    tcw_need_cmd npm

    if [[ "$use_fork" -eq 1 && "$use_latest" -eq 1 ]]; then
        npm install -g --ignore-scripts "github:woodmanlegion/openclaw"
    elif [[ "$use_fork" -eq 1 ]]; then
        npm install -g --ignore-scripts "github:woodmanlegion/openclaw#termux/stable"
    elif [[ "$use_latest" -eq 1 ]]; then
        tcw_warn "Updating to openclaw@latest — patches may break."
        npm install -g --ignore-scripts openclaw@latest
    else
        npm install -g --ignore-scripts "openclaw@$OPENCLAW_PINNED_VERSION"
    fi

    tcw_patch_all
    tcw_write_run_script
    tcw_service_restart
    sleep 5
    tcw_status
    tcw_ok "update complete — log: $TCW_LOG_FILE"
}

# ── Status ────────────────────────────────────────────────────────────────────

tcw_status() {
    echo
    echo -e "${BOLD}══ tclaw status ══${RESET}"
    echo
    echo -e "${BOLD}OpenClaw:${RESET}"
    openclaw --version 2>/dev/null || tcw_err "openclaw CLI not found"
    echo
    echo -e "${BOLD}Service:${RESET}"
    tcw_service_status || true
    echo
    echo -e "${BOLD}Gateway:${RESET}"
    openclaw gateway status 2>/dev/null | grep -E "Runtime|Connectivity|Capability|Dashboard" || true
    echo
    echo -e "${BOLD}Workspace bin:${RESET} $WORKSPACE_BIN"
    echo -e "${BOLD}User bin:${RESET}      $USER_BIN"
    echo -e "${BOLD}Log dir:${RESET}       $TCW_LOG_DIR"
    echo
    echo -e "${BOLD}Patches:${RESET}"
    local svc_file shell_env_file oom_file host_env_file
    svc_file=$(tcw_find_dist_file "service-*.js" "GATEWAY_SERVICE_REGISTRY" 2>/dev/null) || true
    shell_env_file=$(tcw_find_dist_file "shell-env-*.js" "DEFAULT_SHELL" 2>/dev/null) || true
    oom_file=$(tcw_find_dist_file "linux-oom-score-*.js" 2>/dev/null) || true
    host_env_file=$(tcw_find_dist_file "host-env-security-*.js" 2>/dev/null) || true

    if [[ -n "$svc_file" ]] && grep -q "termux-services (runit)" "$svc_file" 2>/dev/null; then
        tcw_ok "gateway service patch"
    else
        tcw_err "gateway service patch missing"
    fi
    if [[ -n "$shell_env_file" ]] && grep -q "DEFAULT_SHELL = \"$PREFIX/bin/bash\"" "$shell_env_file" 2>/dev/null; then
        tcw_ok "shell-env patch"
    else
        tcw_err "shell-env patch missing"
    fi
    if [[ -n "$oom_file" ]] && grep -q "OOM_SCORE_WRAP_SHELL = \"$PREFIX/bin/bash\"" "$oom_file" 2>/dev/null; then
        tcw_ok "linux-oom-score patch"
    else
        tcw_err "linux-oom-score patch missing"
    fi
    if [[ -n "$host_env_file" ]] && ! grep -q '"LD_"' "$host_env_file" 2>/dev/null; then
        tcw_ok "host-env-security patch (LD_ unblocked)"
    else
        tcw_err "host-env-security patch missing"
    fi
    echo
    echo -e "${BOLD}.env:${RESET}"
    if [[ -f "$OPENCLAW_ENV" ]]; then
        tcw_env_show
    else
        tcw_warn "$OPENCLAW_ENV not found"
    fi
}

# ── Logs ──────────────────────────────────────────────────────────────────────

tcw_logs() {
    local logdir logfile
    logdir=$(ls -td "$PREFIX"/tmp/openclaw-*/ 2>/dev/null | head -1)
    if [[ -z "$logdir" ]]; then
        tcw_err "no openclaw log directory found"
        return 1
    fi
    logfile=$(ls -t "$logdir"/openclaw-*.log 2>/dev/null | head -1)
    if [[ -z "$logfile" ]]; then
        tcw_err "no log file found in $logdir"
        return 1
    fi
    tcw_log "tailing $logfile"
    tail -f "$logfile"
}

tcw_tclaw_logs() {
    tcw_log "tclaw logs in $TCW_LOG_DIR:"
    ls -lt "$TCW_LOG_DIR"/*.log 2>/dev/null | head -10 || tcw_warn "no tclaw logs yet"
}

# ── Doctor ────────────────────────────────────────────────────────────────────

tcw_doctor() {
    openclaw doctor "$@"
}

# ── SMS Channel Toggle ────────────────────────────────────────────────────────

tcw_sms_set() {
    local state="$1"
    local label="$2"
    if [[ ! -f "$OPENCLAW_CONFIG" ]]; then
        tcw_err "openclaw.json not found: $OPENCLAW_CONFIG"
        return 1
    fi
    python3 - "$state" <<'PYEOF'
import json, sys
path = "/data/data/com.termux/files/home/.openclaw/openclaw.json"
state = sys.argv[1] == "true"
with open(path) as f:
    cfg = json.load(f)
cfg.setdefault("channels", {}).setdefault("termux-sms-channel", {})["enabled"] = state
with open(path, "w") as f:
    json.dump(cfg, f, indent=2)
PYEOF
    tcw_ok "termux-sms-channel ${label} — run 'tclaw restart' to apply"
}

tcw_sms_on()     { tcw_sms_set true  on;  }
tcw_sms_off()    { tcw_sms_set false off; }
tcw_sms_status() {
    if [[ ! -f "$OPENCLAW_CONFIG" ]]; then
        tcw_warn "openclaw.json not found"; return 1
    fi
    local enabled
    enabled=$(python3 -c "
import json
with open('$OPENCLAW_CONFIG') as f:
    cfg = json.load(f)
print(cfg.get('channels', {}).get('termux-sms-channel', {}).get('enabled', False))
" 2>/dev/null)
    if [[ "$enabled" == "True" ]]; then
        tcw_ok "termux-sms-channel: enabled"
    else
        tcw_warn "termux-sms-channel: disabled"
    fi
}

# ── Help ──────────────────────────────────────────────────────────────────────

tcw_help() {
    echo -e "${BOLD}tclaw — Termux OpenClaw maintenance tool v$VERSION${RESET}"
    echo -e "  Pinned openclaw: ${CYAN}$OPENCLAW_PINNED_VERSION${RESET}"
    echo -e "  User bin:        ${CYAN}$USER_BIN${RESET}"
    echo -e "  Log dir:         ${CYAN}$TCW_LOG_DIR${RESET}"
    echo
    echo "Commands:"
    echo "  install               Install pinned openclaw@$OPENCLAW_PINNED_VERSION + patch"
    echo "  install --latest      Install openclaw@latest + patch (risky)"
    echo "  install --fork        Install from woodmanlegion/openclaw fork (patches pre-applied)"
    echo "  install --fork --latest  Install fork HEAD"
    echo "  patch                 Apply all Termux patches to installed openclaw"
    echo "  update                Re-install pinned version + patch + restart"
    echo "  update --latest       Update to latest + patch + restart (risky)"
    echo "  update --fork         Update from fork + restart"
    echo "  status                Show service, gateway, patch, and path status"
    echo "  start                 sv up openclaw"
    echo "  stop                  sv down openclaw"
    echo "  restart               sv restart openclaw"
    echo "  logs                  Tail the openclaw gateway log"
    echo "  tclaw-logs            List recent tclaw operation logs"
    echo "  doctor                Run openclaw doctor"
    echo "  env                   Show .env keys (values hidden)"
    echo "  bootstrap-claw-gh     Install claw-gh-install skill (runs automatically on install)
  sms-on                Enable termux-sms-channel in openclaw.json"
    echo "  sms-off               Disable termux-sms-channel in openclaw.json"
    echo "  sms-status            Show termux-sms-channel enabled state"
    echo "  help / ?              Show this help"
    echo
    echo "Key paths:"
    echo "  $SCRIPT_DIR/tclaw     this script"
    echo "  $OPENCLAW_CONFIG"
    echo "  $OPENCLAW_ENV"
    echo "  $OPENCLAW_RUN_SCRIPT"
    echo "  $TCW_LOG_DIR"
}

# ── Main ──────────────────────────────────────────────────────────────────────

main() {
    local cmd="${1:-help}"
    case "$cmd" in
        install)      shift; tcw_install "$@" ;;
        patch)        tcw_init_log "patch"; tcw_patch_all ;;
        update)       shift; tcw_update "$@" ;;
        status)       tcw_status "$@" ;;
        start)        tcw_service_up ;;
        stop)         tcw_service_down ;;
        restart)      tcw_service_restart ;;
        logs)         tcw_logs ;;
        tclaw-logs)   tcw_tclaw_logs ;;
        doctor)       tcw_doctor "$@" ;;
        env)          tcw_env_show ;;
        bootstrap-claw-gh) tcw_bootstrap_claw_gh_install ;;
        sms-on)       tcw_sms_on ;;
        sms-off)      tcw_sms_off ;;
        sms-status)   tcw_sms_status ;;
        help|--help|-h|'?'|'/') tcw_help ;;
        *)            tcw_err "unknown command: $cmd"; tcw_help; exit 1 ;;
    esac
}

main "$@"
